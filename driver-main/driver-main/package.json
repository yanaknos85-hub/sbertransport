{
  "name": "@sber-sbertransport-driver/main",
  "version": "1.0.0",
  "private": true,
  "license": "see LICENSE.txt",
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "cracoConfig": "scripts/index.js",
  "scripts": {
    "start": "cross-env REACT_APP_NAME=main craco start --config scripts/index.js",
    "start:dev": "cross-env REACT_APP_NAME=main craco start --config scripts/index.js",
    "start:dev-autopark": "cross-env REACT_APP_NETWORK_LOOP=DEV_AUTOPARK yarn start:dev",
    "start-auth:dev-autopark": "cross-env REACT_APP_BASIC_AUTH=TRUE yarn start:dev-autopark",
    "start-auth-mocked-login:dev-autopark": "cross-env REACT_APP_MOCKED_AUTH=TRUE yarn start-auth:dev-autopark",
    "start-auth-mocked-api:dev-autopark": "cross-env REACT_APP_MOCKED_API=TRUE yarn start-auth:dev-autopark",
    "start-auth-mocked-login-api:dev-autopark": "cross-env REACT_APP_MOCKED_AUTH=TRUE REACT_APP_MOCKED_API=TRUE yarn start-auth:dev-autopark",
    "start:dev-autoservice": "cross-env REACT_APP_NETWORK_LOOP=DEV_AUTOSERVICE yarn start:dev",
    "start-auth:dev-autoservice": "cross-env REACT_APP_BASIC_AUTH=TRUE yarn start:dev-autoservice",
    "start-auth-mocked-login:dev-autoservice": "cross-env REACT_APP_MOCKED_AUTH=TRUE yarn start-auth:dev-autoservice",
    "start-auth-mocked-api:dev-autoservice": "cross-env REACT_APP_MOCKED_API=TRUE yarn start-auth:dev-autoservice",
    "start-auth-mocked-login-api:dev-autoservice": "cross-env REACT_APP_MOCKED_AUTH=TRUE REACT_APP_MOCKED_API=TRUE yarn start-auth:dev-autoservice",
    "start:dev-cargo": "cross-env REACT_APP_NETWORK_LOOP=DEV_CARGO yarn start:dev",
    "start-auth:dev-cargo": "cross-env REACT_APP_BASIC_AUTH=TRUE yarn start:dev-cargo",
    "start-auth-mocked-login:dev-cargo": "cross-env REACT_APP_MOCKED_AUTH=TRUE yarn start-auth:dev-cargo",
    "start-auth-mocked-api:dev-cargo": "cross-env REACT_APP_MOCKED_API=TRUE yarn start-auth:dev-cargo",
    "start-auth-mocked-login-api:dev-cargo": "cross-env REACT_APP_MOCKED_AUTH=TRUE REACT_APP_MOCKED_API=TRUE yarn start-auth:dev-cargo",
    "start:dev-sbertransport": "cross-env REACT_APP_NETWORK_LOOP=DEV_SBERTRANSPORT yarn start:dev",
    "start-auth:dev-sbertransport": "cross-env REACT_APP_BASIC_AUTH=TRUE yarn start:dev-sbertransport",
    "start-auth-mocked-login:dev-sbertransport": "cross-env REACT_APP_MOCKED_AUTH=TRUE yarn start-auth:dev-sbertransport",
    "start-auth-mocked-api:dev-sbertransport": "cross-env REACT_APP_MOCKED_API=TRUE yarn start-auth:dev-sbertransport",
    "start-auth-mocked-login-api:dev-sbertransport": "cross-env REACT_APP_MOCKED_AUTH=TRUE REACT_APP_MOCKED_API=TRUE yarn start-auth:dev-sbertransport",
    "start:dev-st": "cross-env REACT_APP_NETWORK_LOOP=ST yarn start:dev",
    "start-auth:dev-st": "cross-env REACT_APP_BASIC_AUTH=TRUE yarn start:dev-st",
    "start-auth-mocked-login:dev-st": "cross-env REACT_APP_MOCKED_AUTH=TRUE yarn start-auth:dev-st",
    "start-auth-mocked-api:dev-st": "cross-env REACT_APP_MOCKED_API=TRUE yarn start-auth:dev-st",
    "start-auth-mocked-login-api:dev-st": "cross-env REACT_APP_MOCKED_AUTH=TRUE REACT_APP_MOCKED_API=TRUE yarn start-auth:dev-st",
    "start:dev-nt": "cross-env REACT_APP_NETWORK_LOOP=NT yarn start:dev",
    "start-auth:dev-nt": "cross-env REACT_APP_BASIC_AUTH=TRUE yarn start:dev-nt",
    "start-auth-mocked-login:dev-nt": "cross-env REACT_APP_MOCKED_AUTH=TRUE yarn start:dev-nt",
    "start-auth-mocked-api:dev-nt": "cross-env REACT_APP_MOCKED_API=TRUE yarn start-auth:dev-nt",
    "start-auth-mocked-login-api:dev-nt": "cross-env REACT_APP_MOCKED_AUTH=TRUE REACT_APP_MOCKED_API=TRUE yarn start-auth:dev-nt",
    "start:dev-ift": "cross-env REACT_APP_NETWORK_LOOP=IFT yarn start:dev",
    "start-auth:dev-ift": "cross-env REACT_APP_BASIC_AUTH=TRUE yarn start:dev-ift",
    "start-auth-mocked-login:dev-ift": "cross-env REACT_APP_MOCKED_AUTH=TRUE yarn start:dev-ift",
    "start-auth-mocked-api:dev-ift": "cross-env REACT_APP_MOCKED_API=TRUE yarn start-auth:dev-ift",
    "start-auth-mocked-login-api:dev-ift": "cross-env REACT_APP_MOCKED_AUTH=TRUE REACT_APP_MOCKED_API=TRUE yarn start-auth:dev-ift",
    "build": "cross-env REACT_APP_NAME=main craco build",
    "build:debug": "cross-env REACT_APP_DEBUG=TRUE yarn build",
    "build:basic": "cross-env REACT_APP_BASIC_AUTH=TRUE yarn build",
    "build:basic:debug": "cross-env REACT_APP_BASIC_AUTH=TRUE yarn build:debug",
    "build:sigma": "cross-env yarn build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "ci": "rm -rf node_modules && yarn install --frozen-lockfile",
    "clean": "rm -rf node_modules",
    "clean:cache": "rm -rf node_modules/.cache/",
    "up": "yarn add @sber-sbertransport/tool-kit",
    "test": "jest --config jest.config.ts",
    "test:clear": "jest --clearCache",
    "test:ci": "jest --config jest.config.ts --coverage --ci"
  },
  "resolutions": {
    "@parcel/watcher": "2.4.1",
    "history": "5.3.0"
  },
  "dependencies": {
    "@2gis/mapgl": "^1.62.0",
    "@sber-sbertransport/tool-kit": "3.2.3",
    "@tanstack/react-query": "^4.40.1",
    "antd-mobile": "^5.33.0",
    "axios": "0.19.2",
    "cross-env": "^7.0.3",
    "dayjs": "^1.9.8",
    "eslint": "8.56.0",
    "express": "^4.17.3",
    "fp-ts": "^2.16.4",
    "inversify": "5.0.1",
    "io-ts": "^2.2.22",
    "io-ts-reporters": "^1.2.2",
    "mobx": "5.15.4",
    "mobx-react": "6.1.8",
    "ramda": "^0.30.0",
    "react": "^18",
    "react-dom": "^18",
    "react-router": "^7.1.5",
    "react-scripts": "5.0.1",
    "react-virtualized": "^9.22.6",
    "reflect-metadata": "0.2.1",
    "sass": "^1.83.4"
  },
  "devDependencies": {
    "@babel/cli": "^7.16.0",
    "@babel/core": "^7.16.5",
    "@babel/node": "^7.16.5",
    "@babel/plugin-proposal-decorators": "^7.8.3",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.8.3",
    "@babel/plugin-proposal-optional-chaining": "^7.9.0",
    "@babel/plugin-proposal-private-property-in-object": "7.16.7",
    "@babel/plugin-transform-modules-commonjs": "^7.16.5",
    "@babel/preset-env": "^7.16.5",
    "@babel/preset-react": "^7.9.4",
    "@babel/preset-typescript": "^7.12.7",
    "@commitlint/cli": "^11.0.0",
    "@craco/craco": "^6.4.3",
    "@evilmartians/lefthook": "^1.6.7",
    "@testing-library/jest-dom": "5.14.1",
    "@testing-library/react": "11.2.7",
    "@testing-library/react-hooks": "8.0.1",
    "@testing-library/user-event": "14.4.3",
    "@types/jest": "26.0.24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-router-dom": "^5.3.3",
    "babel-jest": "29.7.0",
    "babel-plugin-parameter-decorator": "^1.0.16",
    "babel-plugin-styled-components": "^2.0.6",
    "babel-plugin-transform-typescript-metadata": "^0.3.2",
    "craco-less": "^2.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "28.1.3",
    "ts-jest": "29.4.0",
    "whatwg-fetch": "^3.6.20"
  }
}
