        <!-- Project -->
        <dependency>
            <groupId>ru.sber.transport</groupId>
            <artifactId>transport-core</artifactId>
        </dependency>
        <dependency>
            <groupId>ru.sber.transport</groupId>
            <artifactId>request-model</artifactId>
            <version>250527-1</version>
        </dependency>
        <dependency>
            <groupId>ru.sber.transport</groupId>
            <artifactId>srm-model</artifactId>
            <version>250527-1</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate</groupId>
