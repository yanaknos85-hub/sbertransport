    <artifactId>application</artifactId>
    <name>Request service</name>
    <description>Request service</description>

    <properties>
        <protoc.plugins>target/mvn/grpc</protoc.plugins>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>${maven.compiler.source}</maven.compiler.target>
        <server.port>8011</server.port>
        <start-class>ru.sberbank.ditsib.transport.request.RequestApplication</start-class>
        <proto.source.root>../_documents/api/grpc</proto.source.root>
        <hibernate.jpamodelgen.version>5.6.15.Final</hibernate.jpamodelgen.version>
        <ext-logging.version>260408-1</ext-logging.version>
        <grpc-bom.version>4.16</grpc-bom.version>
        <integrations.messaging.version>5.5</integrations.messaging.version>
        <request.messaging.version>5.15</request.messaging.version>
        <payout.grpc.version>5.3.0.1</payout.grpc.version>
        <payout.messaging.version>5.14</payout.messaging.version>
