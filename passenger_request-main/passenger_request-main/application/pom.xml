        </dependency>
        <dependency>
            <groupId>ru.sberbank.ditsib.transport.integrations-carsharing</groupId>
            <artifactId>integrations-carsharing-messaging</artifactId>
            <version>250527-1</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
