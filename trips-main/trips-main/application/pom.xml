        </dependency>
        <dependency>
            <groupId>ru.sber.transport.dispatcher</groupId>
            <artifactId>messaging</artifactId>
            <version>5.9</version>
        </dependency>
        <dependency>
            <groupId>ru.sber.transport</groupId>
            <artifactId>request-messaging</artifactId>
            <version>240426-1</version>
            <exclusions>
                <exclusion>
                    <groupId>ru.sber.transport</groupId>
