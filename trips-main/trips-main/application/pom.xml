        </dependency>
        <dependency>
            <groupId>ru.sber.transport.trips</groupId>
            <artifactId>messaging</artifactId>
            <version>5.10.0.1</version>
        </dependency>
        <dependency>
            <groupId>ru.sber.transport.driver_track</groupId>
            <artifactId>messaging</artifactId>
            <version>4.2.0.1</version>
            <exclusions>
                <exclusion>
                    <groupId>ru.sber.transport</groupId>
                    <artifactId>kafka-functional</artifactId>
                </exclusion>
            </exclusions>
