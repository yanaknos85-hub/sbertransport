    <version>5.8</version>

    <name>Constants</name>

    <properties>
        <sonar.projectKey>TRANSPORT_constants</sonar.projectKey>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-java-commons</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ru.sber.qa</groupId>
            <artifactId>allure-annotations</artifactId>
