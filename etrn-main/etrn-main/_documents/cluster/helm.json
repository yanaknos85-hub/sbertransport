{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HELM values",
  "type": "object",
  "required": [
    "application",
    "repo",
    "resources",
    "secman"
  ],
  "properties": {
    "application": {
      "type": "string",
      "description": "Наименование приложения"
    },
    "repo": {
      "type": "string",
      "description": "Репозиторий с исходным кодом приложения"
    },
    "image": {
      "additionalProperties": false,
      "type": "object",
      "description": "Данные образа для деплоя",
      "properties": {
        "tag": {
          "type": "string",
          "description": "Тег для выгрузки (предпочтительна установка значения командой helm templage --set image.tag=tag)",
          "example": [
            ":some-version",
            "@sha256:sha value"
          ]
        }
      }
    },
    "resources": {
      "required": [
        "limits",
        "requests"
      ],
      "additionalProperties": false,
      "type": "object",
      "description": "Выделяемые ресурсы",
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory"
          ],
          "description": "Ресурсы пиковой нагрузки",
          "properties": {
            "cpu": {
              "type": "string",
              "description": "Используемые процессоры",
              "example": [
                "1",
                "200m",
                "0.2"
              ]
            },
            "memory": {
              "type": "string",
              "description": "Используемая память",
              "example": [
                "1G",
                "200M",
                "0.2G"
              ]
            }
          }
        },
        "requests": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "description": "Ресурсы крейсерской нагрузки",
          "properties": {
            "cpu": {
              "type": "string",
              "description": "Используемые процессоры",
              "example": [
                "1",
                "200m",
                "0.2"
              ]
            },
            "memory": {
              "type": "string",
              "description": "Используемая память",
              "example": [
                "1G",
                "200M",
                "0.2G"
              ]
            }
          }
        }
      }
    },
    "port": {
      "additionalProperties": false,
      "description": "Используемые порты приложения",
      "type": "object",
      "properties": {
        "http": {
          "additionalProperties": false,
          "description": "HTTP-порт",
          "type": "object",
          "required": [
            "number",
            "name",
            "target"
          ],
          "properties": {
            "number": {
              "type": "number",
              "description": "Номер порта приложения",
              "minValue": 8000,
              "maxValue": 65535,
              "example": 8080
            },
            "name": {
              "type": "string",
              "description": "Наименование порта"
            },
            "target": {
              "type": "number",
              "description": "Номер порта сервиса, на который будут приходить запросы",
              "minValue": 8000,
              "maxValue": 65535,
              "example": 8080
            }
          }
        },
        "grpc": {
          "additionalProperties": false,
          "description": "gRPC-порт",
          "type": "object",
          "required": [
            "number"
          ],
          "properties": {
            "number": {
              "type": "number",
              "description": "Номер порта приложения",
              "minValue": 6565,
              "maxValue": 65535,
              "example": 6565
            },
            "name": {
              "type": "string",
              "description": "Наименование порта"
            },
            "target": {
              "type": "number",
              "description": "Номер порта сервиса, на который будут приходить запросы",
              "minValue": 6565,
              "maxValue": 65535,
              "example": 6565
            }
          }
        }
      }
    },
    "routing": {
      "additionalProperties": false,
      "description": "Маршрутизация запроса",
      "type": "object",
      "properties": {
        "internal": {
          "type": "boolean",
          "description": "Признак внутреннего маршрута. Для internal=true не будет создаваться маршрут извне",
          "defaultBoolean": false
        },
        "match": {
          "additionalProperties": false,
          "type": "object",
          "description": "Правило соответствия суффикса урла",
          "properties": {
            "prefix": {
              "type": "string",
              "description": "Часть урла, по которой определяется маршрут",
              "example": "/api/v1/users"
            }
          }
        },
        "rewrite": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "uri"
          ],
          "description": "Правило подмены урла",
          "properties": {
            "uri": {
              "type": "string",
              "description": "Значение, на которое будет заменен обнаруженный урл. Например, если есть правило маршрутизации `prefix: /api/url`, а `rewrite.uri = /v2/rewritten`, то при запроса с `/api/url/someUrl` в приложение пойдет запрос `/v2/rewritten/someUrl`",
              "example": [
                " ",
                "/users"
              ]
            }
          }
        }
      }
    },
    "kafka": {
      "type": "array",
      "description": "Режимы работы кафки",
      "items": {
        "additionalProperties": false,
        "type": "string",
        "enum": [
          "plaintext",
          "ssl",
          "avro"
        ]
      }
    },
    "profiles": {
      "type": "string",
      "description": "Список профилей через запятую для запуска приложения"
    },
    "secman": {
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "type": "object",
      "description": "Настройки работы с секманом",
      "properties": {
        "type": {
          "description": "Тип работы с секманом",
          "type": "string",
          "enum": [
            "none",
            "built_in",
            "configmap",
            "container"
          ],
          "default": "none"
        },
        "startClass": {
          "description": "Запускаемый класс. Имеет вес только если type configmap или container",
          "type": "string",
          "example": "ru.sber.transport.Application"
        }
      }
    },
    "additional": {
      "additionalProperties": false,
      "type": "object",
      "description": "Дополнительные настройки приложения",
      "properties": {
        "annotations": {
          "type": "object",
          "description": "Список аннотаций"
        },
        "labels": {
          "type": "object",
          "description": "Дополнительные метки"
        },
        "envs": {
          "type": "array",
          "description": "Список переменных окружения",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "description": "Описание переменной окружения",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "description": "Название переменной окружения",
                "type": "string"
              },
              "value": {
                "description": "Значение переменной окружения",
                "type": "string"
              },
              "valueFrom": {
                "description": "Получение значения из другого ресурса",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "configMapKeyRef": {
                    "description": "Ссылка на конфигмап",
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "name",
                      "key"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Название конфигмапы"
                      },
                      "key": {
                        "type": "string",
                        "description": "Ключ из конфигмапы"
                      }
                    }
                  },
                  "secretKeyRef": {
                    "description": "Ссылка на секрет",
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "name",
                      "key"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Название секрета"
                      },
                      "key": {
                        "type": "string",
                        "description": "Ключ из секрета"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "configMap": {
          "type": "array",
          "description": "Список конфигмапов",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "description": "Новая конфигмапа",
            "required": [
              "name",
              "data"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Наименование конфигмапы"
              },
              "data": {
                "description": "Данные конфигмапы",
                "type": "object"
              }
            }
          }
        },
        "volumes": {
          "type": "array",
          "description": "Список подключаемых файлов/директорий/разделов",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "description": "Данные раздела",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Наименование раздела"
              },
              "configMap": {
                "additionalProperties": false,
                "type": "object",
                "description": "Подключить конфигмапу как раздел",
                "required": [
                  "name",
                  "defaultMode"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Наименование раздела"
                  },
                  "defaultMode": {
                    "type": "number",
                    "description": "Режим доступа"
                  },
                  "optional": {
                    "type": "boolean",
                    "description": "Признак обязательности раздела",
                    "defaultBoolean": false
                  }
                }
              }
            }
          }
        },
        "mounts": {
          "type": "array",
          "description": "Список монтирований",
          "items": {
            "additionalProperties": false,
            "description": "Описание монтирования",
            "required": [
              "name",
              "mountPath"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Наименование раздела"
              },
              "mountPath": {
                "type": "string",
                "description": "Путь для монтирования"
              },
              "subPath": {
                "type": "string",
                "description": "Путь для монтирования файла"
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}